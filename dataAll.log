  user@db.local  → 2: [isString, isEmail]
  8080           → 3: [isString, isNumber, isPort]
  hello world    → 1: [isString]

=== TYPE → its members (the extension of each predicate) ===
  isInternalIP   = {192.168.1.2}
  isIP           = {192.168.1.2, 8.8.8.8}
  isHost         = {192.168.1.2, 8.8.8.8, db01.internal}
  isString       = {192.168.1.2, 8.8.8.8, db01.internal, user@db.local, 8080, hello world}

